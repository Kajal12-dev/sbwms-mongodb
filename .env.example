# Local MongoDB (default install). Use 127.0.0.1 instead of "localhost" -
# on Node 17+ "localhost" can resolve to IPv6 (::1) and fail to connect.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sbwms
PORT=3000

# MongoDB Atlas (cloud) - replace the URI above with your own, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
